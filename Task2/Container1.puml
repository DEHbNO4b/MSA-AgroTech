@startuml Context Diagram MVP платформы мониторинга животноводческих ферм «АгроТех Х»
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Контекстная диаграмма Вариант 1:  Edge-Heavy микросервисная архитектура

Person(оператор, "Оператор фермы")
Person(аналитик, "аналитик")

System(central_server, "Центральная система", "аналитика, отчетность, метрики")
System(edge_agent, "Edge-сервер фермы", "Локальная обработка данных, управление устройствами")

System_Ext(телеком, "Телеком оператор", "Телеком оператор для отправки смс")
System_Ext(видеоаналитика, "Сервис видеоаналитики", "детекция аномального поведения.трекинг")
System_Ext(api, "Внешний API", "API для интеграции внешних систем")

' Connections
Rel(телеком, оператор, "Смс уведомление")
Rel(аналитик, central_server, "Rest")

Rel(edge_agent, central_server, "Kafka Protocol")
Rel(edge_agent, телеком, "Смс уведомление")
Rel(edge_agent, видеоаналитика, "Видеоаналитика")

Rel(central_server, api, "Предоставляет внешний API")

@enduml

